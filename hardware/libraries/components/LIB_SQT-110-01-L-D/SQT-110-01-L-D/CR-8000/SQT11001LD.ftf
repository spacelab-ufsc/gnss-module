          (pin 12
            (pt -1000000 200000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1000000 200000)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
              )
            )
          )
          (pin 13
            (pt -1200000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1200000 0)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
