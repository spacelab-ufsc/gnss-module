          (pin 16
            (pt -1400000 200000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1400000 200000)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
              )
            )
          )
          (pin 17
            (pt -1600000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1600000 0)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
              )
            )
          )
          (pin 18
            (pt -1600000 200000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1600000 200000)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
              )
            )
          )
          (pin 19
            (pt -1800000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1800000 0)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
              )
            )
          )
          (pin 20
            (pt -1800000 200000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -1800000 200000)
                  (angle 90)
                  (padstackGroup default (padstack c141.6h91))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape SQT-110-01-L-D.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

